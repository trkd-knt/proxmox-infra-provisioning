# interfaces.j2
# Proxmox network configuration
# This file is generated by Ansible, do not edit it manually

auto lo
iface lo inet loopback
# loopback interface

auto {{ uplink_interface }}
iface {{ uplink_interface }} inet manual
    ovs_type OVSPort
    ovs_bridge ovsbr0
# {{ uplink_interface }} physical interface

auto ovsbr0
iface ovsbr0 inet manual
    ovs_type OVSBridge
    ovs_ports {{ uplink_interface }}
    address {{ ovs_ip_address }}
    gateway {{ ovs_gateway }}
# OVS base bridge

auto vlan10
iface vlan10 inet manual
    address {{ vlan10_address }}
    gateway {{ vlan10_gateway }}
    ovs_type OVSIntPort
    ovs_bridge ovsbr0
    ovs_options tag=10
# OVS VLAN 10 (for Front Service Segment)

auto vmbr10
iface vmbr10 inet manual
    ovs_type OVSBridge
    ovs_ports vlan10
# OVS Bridge for VLAN 10

auto vlan20
iface vlan20 inet manual
    address {{ vlan20_address }}
    gateway {{ vlan20_gateway }}
    ovs_type OVSIntPort
    ovs_bridge ovsbr0
    ovs_options tag=20
# OVS VLAN 20 (for Backend Service Segment)

auto vmbr20
iface vmbr20 inet manual
    ovs_type OVSBridge
    ovs_ports vlan20
# OVS Bridge for VLAN 20

auto vlan30
iface vlan30 inet manual
    address {{ vlan30_address }}
    gateway {{ vlan30_gateway }}
    ovs_type OVSIntPort
    ovs_bridge ovsbr0
    ovs_options tag=30
# OVS VLAN 30 (for Operation Segment)

auto vmbr30
iface vmbr30 inet manual
    ovs_type OVSBridge
    ovs_ports vlan30
# OVS Bridge for VLAN 30
