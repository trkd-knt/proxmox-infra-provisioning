# interfaces.j2
# Proxmox network configuration
# This file is generated by Ansible, do not edit it manually

# ループバックインターフェース
auto lo
iface lo inet loopback

# {{ uplink_interface }}をOVSポートとして定義（uplink）
auto {{ uplink_interface }}
iface {{ uplink_interface }} inet manual
    ovs_type OVSPort
    ovs_bridge ovsbr0

# OVSのベースブリッジ（物理インターフェース用）
auto ovsbr0
iface ovsbr0 inet manual
    ovs_type OVSBridge
    ovs_ports {{ uplink_interface }}
    address {{ ovs_ip_address }}
    gateway {{ ovs_gateway }}
