# Proxmox network configuration
# This file is generated by Ansible, do not edit it manually

auto ovsbr_vlan20
iface ovsbr_vlan20 inet static
    address {{ management_ip }}
    netmask {{ netmask }}
    gateway {{ gateway }}
    ovs_type OVSBridge
    ovs_ports enp3s1.10

auto enp3s1.10
iface enp3s1.10 inet manual
    ovs_type OVSPort
    ovs_bridge ovsbr_vlan20

auto ovsbr_vlan10
iface ovsbr_vlan10 inet manual
    ovs_type OVSBridge
    ovs_ports enp3s1.20

auto enp3s1.20
iface enp3s1.20 inet manual
    ovs_type OVSPort
    ovs_bridge ovsbr_vlan10
