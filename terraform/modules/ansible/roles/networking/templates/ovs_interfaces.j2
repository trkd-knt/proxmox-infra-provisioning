# Proxmox network configuration
# This file is generated by Ansible, do not edit it manually

    # ループバックインターフェース
    auto lo
    iface lo inet loopback
    # eth0をOVSポートとして定義（uplink）
    auto eth0
    iface eth0 inet manual
        ovs_type OVSPort
        ovs_bridge ovsbr0
    
    # OVSのベースブリッジ（物理インターフェース用）
    auto ovsbr0
    iface ovsbr0 inet manual
        ovs_type OVSBridge
        ovs_ports eth0
    
    # VLAN 10（サービス用）
    auto vlan10
    iface vlan10 inet manual
        ovs_type OVSIntPort
        ovs_bridge ovsbr0
        ovs_options tag=10
    
    auto vmbr10
    iface vmbr10 inet manual
        ovs_type OVSBridge
        ovs_ports vlan10
    
    # VLAN 20（運用用1）
    auto vlan20
    iface vlan20 inet manual
        ovs_type OVSIntPort
        ovs_bridge ovsbr0
        ovs_options tag=20
    
    auto vmbr20
    iface vmbr20 inet manual
        ovs_type OVSBridge
        ovs_ports vlan20
    
    # VLAN 30（運用用2）
    auto vlan30
    iface vlan30 inet manual
        ovs_type OVSIntPort
        ovs_bridge ovsbr0
        ovs_options tag=30
    
    auto vmbr30
    iface vmbr30 inet manual
        ovs_type OVSBridge
        ovs_ports vlan30
    